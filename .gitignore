dist/
.claude/
.envrc
*.pem
*.key
*.p12
*.pfx
*.sqlite*
*.db
coverage/
output/
.playwright-cli/

# 配乐：mp3 放在 assets/audio/，曲目写在 js/music-tracks.js（音乐有版权，不进仓库）
assets/audio/

# 个人内容：书的真实封面（出版社的版权）、个人照片、真实简历和联系方式（电话、邮箱、照片、PDF）。
# 公开的 index.html 里放样例，这些只在本地用（见 README 的"改内容"）
assets/books/covers/
assets/books/books.html
photos-src/
assets/photos/
assets/posters/
assets/resume/

